{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "money-coach config.json",
 "description": "Written only from the user's onboarding answers (scripts/config_tool.py). Each section is documented in docs/onboarding/.",
 "type": "object",
 "required": [
  "income",
  "plan",
  "split",
  "fixed_bills",
  "subscriptions",
  "categories",
  "cards",
  "goal",
  "tax",
  "tone"
 ],
 "properties": {
  "tone": {
   "enum": [
    "gentle",
    "honest",
    "savage"
   ]
  },
  "currency": {
   "type": "string"
  },
  "plan": {
   "type": "object",
   "required": [
    "start_month",
    "months"
   ],
   "properties": {
    "start_month": {
     "type": "string",
     "pattern": "^\\d{4}-\\d{2}$"
    },
    "months": {
     "type": "integer",
     "minimum": 1
    }
   }
  },
  "income": {
   "type": "object",
   "required": [
    "frequency",
    "take_home_per_paycheck"
   ],
   "properties": {
    "frequency": {
     "enum": [
      "weekly",
      "biweekly",
      "semimonthly",
      "monthly"
     ]
    },
    "take_home_per_paycheck": {
     "type": "number"
    },
    "changes": {
     "type": "array",
     "items": {
      "type": "object",
      "required": [
       "from",
       "take_home_per_paycheck"
      ]
     }
    },
    "extra_pay": {
     "type": "array",
     "items": {
      "type": "object",
      "required": [
       "label",
       "month",
       "amount_after_tax"
      ],
      "properties": {
       "confirmed": {
        "type": "boolean"
       },
       "route_to": {
        "type": "string"
       }
      }
     }
    }
   }
  },
  "split": {
   "type": "object",
   "required": [
    "accounts",
    "remainder"
   ],
   "properties": {
    "accounts": {
     "type": "array",
     "items": {
      "type": "object",
      "required": [
       "name",
       "kind",
       "per_paycheck"
      ],
      "properties": {
       "kind": {
        "enum": [
         "savings",
         "bills",
         "spending"
        ]
       }
      }
     }
    },
    "remainder": {
     "type": "string"
    }
   }
  },
  "cards": {
   "type": "array",
   "items": {
    "type": "string"
   }
  },
  "fixed_bills": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "name",
     "paid_from",
     "amount"
    ],
    "properties": {
     "start": {
      "type": "string"
     },
     "end": {
      "type": "string"
     }
    }
   }
  },
  "subscriptions": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "name",
     "amount",
     "active"
    ]
   }
  },
  "cap_multipliers": {
   "type": "object",
   "required": [
    "protect",
    "normal",
    "cut"
   ]
  },
  "categories": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "name",
     "priority"
    ],
    "properties": {
     "priority": {
      "enum": [
       "protect",
       "normal",
       "cut"
      ]
     },
     "cap": {
      "type": [
       "number",
       "null"
      ]
     }
    }
   }
  },
  "payroll": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "label",
     "monthly"
    ]
   }
  },
  "goal": {
   "type": "object",
   "required": [
    "target",
    "deadline"
   ]
  },
  "tax": {
   "type": "object",
   "required": [
    "federal_marginal",
    "state_marginal"
   ]
  },
  "loans": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "name",
     "currency",
     "outstanding",
     "rate",
     "type",
     "current_payment"
    ],
    "properties": {
     "type": {
      "enum": [
       "Compound",
       "Simple-flat",
       "Simple-rebate"
      ]
     }
    }
   }
  },
  "investments": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "name",
     "expected_return"
    ]
   }
  },
  "lvi": {
   "type": "object"
  }
 }
}
